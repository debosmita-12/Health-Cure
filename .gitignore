# Root .gitignore for Health & Cure Platform

# Compiled Java / Maven target directories
target/
**/target/
*.class

# Node / Frontend build & dependencies
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/

# Environment files
.env
.env.local
.env.*.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor files
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Scratch files
scratch/
*.tmp
backend/data/
*.mv.db
*.trace.db
